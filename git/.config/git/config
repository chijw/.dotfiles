# Shared git settings (identity stays in the machine-local ~/.gitconfig).
# Diffs go through delta, colored like the rest of the setup.
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[merge]
	conflictStyle = zdiff3
[delta]
	navigate = true # n/N jump between files
	features = side-by-side
	line-numbers = true
	syntax-theme = Catppuccin Mocha
	file-style = bold "#cdd6f4"
	file-decoration-style = "#3a3a3e" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#3a3a3e" box
	line-numbers-minus-style = "#f38ba8"
	line-numbers-plus-style = "#a6e3a1"
	line-numbers-zero-style = "#6c6c72"
	line-numbers-left-style = "#3a3a3e"
	line-numbers-right-style = "#3a3a3e"
	minus-style = syntax "#49353c"
	minus-emph-style = syntax "#694550"
	plus-style = syntax "#3a463b"
	plus-emph-style = syntax "#4e644e"
[delta "side-by-side"]
	side-by-side = true
