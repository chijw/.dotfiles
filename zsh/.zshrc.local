# Sourced from ~/.zshrc after the Zim bootstrap block (see install.sh),
# so zle / bindkey customizations apply after Zim is initialized.

# Environment
export http_proxy="${http_proxy-http://127.0.0.1:7890}"
export https_proxy="${https_proxy-http://127.0.0.1:7890}"
export all_proxy="${all_proxy-socks5://127.0.0.1:7890}"
export HOMEBREW_API_DOMAIN="https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles/api"
export FZF_DEFAULT_COMMAND='fd --type f'
export FZF_DEFAULT_OPTS_FILE="$HOME/.config/fzf/fzfrc"  # vim-style keys
export PATH="$HOME/scripts:$PATH"
export EDITOR="nvim"

# Aliases
alias pp="pngpaste"
alias vim="nvim"
alias lg="lazygit"
# kitten ssh copies kitty's terminfo to the remote host, fixing
# "missing or unsuitable terminal: xterm-kitty".
[[ "$TERM" == "xterm-kitty" ]] && alias ssh="kitten ssh"

# vi-mode cursor shape: block in normal mode, beam otherwise
_beam_cursor() { echo -ne '\e[5 q' }
zle-keymap-select() {
  case $KEYMAP in
    vicmd) echo -ne '\e[1 q' ;;
    main|viins|'') _beam_cursor ;;
  esac
}
zle -N zle-keymap-select
precmd_functions+=(_beam_cursor)
preexec_functions+=(_beam_cursor)
KEYTIMEOUT=1

# vi-mode paste from the system clipboard
vi-paste-from-system-clipboard() {
  if [[ "$OSTYPE" == darwin* ]]; then
    LBUFFER+="$(pbpaste)"
  else
    LBUFFER+="$(xclip -o -selection clipboard 2>/dev/null)"
  fi
}
zle -N vi-paste-from-system-clipboard
bindkey -M vicmd 'p' vi-paste-from-system-clipboard

# yazi: cd to the directory yazi exits in
y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  command yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
  rm -f -- "$tmp"
}

[[ -f ~/fzf.zsh ]] && source ~/fzf.zsh

# lazygit on macOS ignores ~/.config unless pointed there.
export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml"

# rgf [pattern]: live ripgrep in fzf; Enter opens the match in nvim at that line.
rgf() {
  local rg='rg --column --line-number --no-heading --color=always --smart-case'
  local init=:
  [[ -n $1 ]] && init="$rg -- ${(q)*}"
  FZF_DEFAULT_COMMAND=$init fzf --ansi --disabled --query "$*" \
    --bind "change:reload:sleep 0.1; $rg -- {q} || true" \
    --delimiter : \
    --preview 'bat --color=always --highlight-line {2} {1}' \
    --preview-window 'up,60%,border-bottom,+{2}+3/3,~3' \
    --bind 'enter:become(nvim {1} +{2})'
}

# clip: copy stdin to the clipboard. Locally uses pbcopy; over SSH (or without
# pbcopy) sends an OSC 52 escape that kitty turns into a local copy, through
# tmux too, so remote servers need no xclip.
clip() {
  local data; data=$(cat)
  if [[ -z $SSH_TTY ]] && (( $+commands[pbcopy] )); then
    print -rn -- "$data" | pbcopy
  else
    printf '\e]52;c;%s\a' "$(print -rn -- "$data" | base64 | tr -d '\n')" > /dev/tty
  fi
}

# fzfp [fzf args]: pick with fzf and copy the choice (Tab-marked ones, one per line).
fzfp() {
  local sel; sel=$(fzf "$@") || return
  print -rn -- "$sel" | clip
  print -r -- "$sel"
}

# zoxide: `z foo` jumps to a frequent directory, `zi` picks one with fzf.
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"
